# ==== NEURAVEX environment configuration ====
# Copy this file to .env and fill in real values. NEVER commit .env.

# --- App ---
NEURAVEX_ENV=development
NEURAVEX_SECRET_KEY=change-me-to-a-random-64-char-string

# --- Safety switch: this must be explicitly "true" for live trading to even
# be reachable in code, IN ADDITION to config.trading.mode == "live".
# Default is false. Do not set this to true until you have completed
# backtest -> paper -> validation and understand the risks. ---
NEURAVEX_ALLOW_LIVE=false

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=neuravex
POSTGRES_USER=neuravex
POSTGRES_PASSWORD=change-me

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# --- Exchange credentials (sandbox first!) ---
# Leave empty while running in paper mode; the paper adapter does not
# need real keys at all.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_USE_TESTNET=true

# --- LLM (used ONLY for context/summaries/explanations, never for order
# execution decisions — see trading_engine/decision_engine.py) ---
ANTHROPIC_API_KEY=

# --- Alerts (optional, modular) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- Production deployment (VPS + domain) ---
# Only needed when running via docker-compose on a real server, not for
# local/emulator testing. Must match the domains you set in
# docker/caddy/Caddyfile and pointed your domain's DNS at this server.
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
CORS_ALLOWED_ORIGIN=https://yourdomain.com
